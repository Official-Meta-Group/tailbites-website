# TAILBITE'S static website — Apache / Veebimajutus.ee
# Use in the static site's document root. Read UPLOAD-GUIDE.md first.
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Keep certificate-validation requests available.
    RewriteRule ^\.well-known/acme-challenge/ - [L]

    # Canonical HTTPS domain; development/staging hosts are not redirected.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?tailbites\.eu$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.tailbites\.eu$ [NC]
    RewriteRule ^ https://tailbites.eu%{REQUEST_URI} [R=301,L,NE]

    # One homepage URL. THE_REQUEST avoids redirecting DirectoryIndex internally.
    RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # Do not expose hidden configuration/version-control files or backups.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule \.(?:bak|backup|sql|log|ini|conf)$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-NnKyV2vFpLObZfD5XvFmMJByUUarg4mVWosUAn7jAtc=' 'sha256-6qMlCAHBikuU8Wo2hhlPvxdHtxwfN0K+JtrSe6oXtco=' 'sha256-5QXLW/Ncuw9uQ0F05VnHnxWPvmWYPUl+2y1bln1Jhf4=' 'sha256-X2kRN5vJ82msK1ecgTa4kJNDhccQnL7Ah0mQg0teYTI='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
    # Short initial HSTS period; no preload or subdomain commitment.
    Header always set Strict-Transport-Security "max-age=86400" "expr=%{HTTPS} == 'on'"
    <FilesMatch "\.(?:html|xml|txt)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(?:css|js)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(?:png|jpg|jpeg|webp|avif|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <Files "404.html">
        Header always set X-Robots-Tag "noindex, follow"
    </Files>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml text/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType application/xml .xml
</IfModule>
